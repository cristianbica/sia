#!/bin/sh

set -u

ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
SUITE=${1:-all}

run_static() {
  sh "$ROOT/tests/static/source-contracts.sh" &&
    sh "$ROOT/tests/behavior/activation/static-contracts.sh" &&
    PYTHONDONTWRITEBYTECODE=1 python3 "$ROOT/tests/behavior/routing/context-contracts.py" &&
    PYTHONDONTWRITEBYTECODE=1 python3 "$ROOT/tests/behavior/contracts/test_contracts.py" &&
    PYTHONDONTWRITEBYTECODE=1 python3 "$ROOT/tests/coding/test_fixtures.py" &&
    sh "$ROOT/tests/hosts/static-contracts.sh" &&
    PYTHONDONTWRITEBYTECODE=1 python3 "$ROOT/tests/hosts/approval-contracts.py" &&
    PYTHONDONTWRITEBYTECODE=1 python3 "$ROOT/.ai/skills/benchmark/scripts/test_accounting.py"
}

run_installer() {
  PYTHONDONTWRITEBYTECODE=1 python3 "$ROOT/tests/installer/install/global.py" &&
    sh "$ROOT/tests/installer/install/stage1.sh" &&
    sh "$ROOT/tests/installer/github/bootstrap.sh"
}

case "$SUITE" in
  all)
    run_static && run_installer
    ;;
  static)
    run_static
    ;;
  installer)
    run_installer
    ;;
  *)
    echo "usage: sh scripts/verify [all|static|installer]" >&2
    exit 2
    ;;
esac
