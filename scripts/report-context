#!/usr/bin/env python3
"""Report declared Sia delivery context size; this does not measure model tokens or billing."""
import argparse
from pathlib import Path, PurePosixPath
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent
WORKFLOW = 'src/managed/.ai/workflows/sia/delivery.md'
COMMON = ['src/managed/.ai/sia.md', 'src/seed/.ai/RULES.md',
          'src/managed/.ai/operations/sia/implement.md', 'src/seed/.ai/docs/INDEX.md']
COMMON += [f'src/managed/catalogs/{name}.md' for name in ('operations', 'workflows', 'skills')]
COMMON += [f'src/managed/.ai/skills/sia/{name}/SKILL.md' for name in ('repository-discovery', 'testing')]


def read(path, ref=None):
    if ref:
        return subprocess.check_output(['git', 'show', f'{ref}:{path}'], cwd=ROOT, text=True)
    return (ROOT / path).read_text()


def support_map(body):
    rows = {}
    for name, links in re.findall(r'^\| ([a-z]+(?:-[a-z]+)?) \| (.+) \|$', body, re.M):
        paths = re.findall(r'\]\(([^)]+)\)', links)
        if name in rows or (not paths and links != 'none'):
            raise ValueError(f'invalid delivery row: {name}')
        for path in paths:
            if not path.startswith('delivery/') or '..' in PurePosixPath(path).parts:
                raise ValueError(f'invalid delivery support path: {path}')
        rows[name] = [str(PurePosixPath(WORKFLOW).parent / path) for path in paths]
    if not rows:
        raise ValueError('missing support table')
    return rows


def measure(ref=None):
    supports = support_map(read(WORKFLOW, ref))
    def count(paths):
        paths = list(dict.fromkeys(paths))
        texts = [read(path, ref) for path in paths]
        return dict(documents=len(paths), words=sum(len(s.split()) for s in texts),
                    bytes=sum(len(s.encode()) for s in texts), paths=paths)
    common = COMMON + [WORKFLOW]
    result = {name: count(common + paths) for name, paths in supports.items()}
    review = ['src/managed/.ai/skills/sia/code-review/SKILL.md']
    ordinary = supports.get('coding', supports.get('standard-plan', []))
    later = [] if 'coding' in supports else supports.get('standard-execute', [])
    result['coding-complete'] = count(common + ordinary + later + review)
    result['all-delivery-support'] = count(common + [p for ps in supports.values() for p in ps] + review)
    if ref:
        shipped = subprocess.check_output(['git', 'ls-tree', '-r', '--name-only', ref, '--', 'src'],
                                          cwd=ROOT, text=True).splitlines()
        shipped = [p for p in shipped if p.endswith('.md')]
    else:
        shipped = [str(p.relative_to(ROOT)) for p in sorted((ROOT / 'src').rglob('*.md'))]
    result['all-shipped-markdown'] = count(shipped)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--baseline-ref', help='earlier source revision; reads only source definition paths')
    args = parser.parse_args()
    current = measure()
    baseline = measure(args.baseline_ref) if args.baseline_ref else None
    print('use\tdocuments\twords\tUTF8_bytes' + ('\tbaseline_words\tword_change' if baseline else ''))
    aliases = {'coding': 'standard-plan', 'saved-plan': 'standard-plan', 'forge': 'forge-intake'}
    for use, values in current.items():
        row = [use, values['documents'], values['words'], values['bytes']]
        if baseline:
            before = baseline.get(use, baseline.get(aliases.get(use)))
            row += [before['words'], values['words'] - before['words']] if before else ['n/a', 'n/a']
        print('\t'.join(map(str, row)))
    print('Static words/bytes, not model tokens, cost, or proof of behavior. Includes common intake definitions.')
    print('coding-complete includes later execution and review loads; all-delivery-support counts their union once.')
    print('Old coding baseline is standard-plan; all-shipped-markdown includes every Markdown file under src.')
    print('Excludes host instructions, project overrides/docs/code and conversation history.')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
